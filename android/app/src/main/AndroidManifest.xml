<?xml version="1.0" encoding="utf-8"?>
<!-- The permission list IS the privacy policy (PRD §5): no READ_CONTACTS
     ever, no READ_CALL_LOG (the screening role needs none of it). INTERNET
     exists for exactly one code path — UpdateManager fetching the signed
     DB shard, user-triggered/schedulable/disableable; call screening never
     touches the network. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- F1 label surface: heads-up warnings for flagged/blocked calls. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Opt-in large on-screen badge during flagged calls (special-access
       toggle; inert until the user grants "Display over other apps"). -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <application
    android:label="OpenCaller"
    android:icon="@mipmap/ic_launcher"
    android:allowBackup="false"
    android:theme="@android:style/Theme.Material.Light.NoActionBar">

    <activity
      android:name=".MainActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- Opt-in WhatsApp call warnings. Notification access is a broad OS
         permission; our code processes ONLY WhatsApp incoming-call
         notifications (see CallNotificationListener's privacy contract).
         Warn-only: Android does not allow blocking another app's VoIP
         calls. Disabled until the user enables it in system settings. -->
    <service
      android:name=".CallNotificationListener"
      android:label="OpenCaller WhatsApp call warnings"
      android:exported="false"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <service
      android:name=".ScreeningService"
      android:permission="android.permission.BIND_SCREENING_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.telecom.CallScreeningService" />
      </intent-filter>
    </service>
  </application>
</manifest>
